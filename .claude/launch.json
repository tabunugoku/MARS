{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5190",
        "--directory",
        "site"
      ],
      "port": 5190
    }
  ]
}
